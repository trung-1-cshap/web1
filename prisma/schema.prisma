generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  password     String
  name         String?
  role         String        @default("ACCOUNTANT")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
}

model Category {
  id           Int             @id @default(autoincrement())
  name         String
  type         TransactionType
  createdAt    DateTime        @default(now())
  transactions Transaction[]
}

model Account {
  id             Int           @id @default(autoincrement())
  name           String        @unique
  initialBalance Decimal       @default(0) @db.Decimal(15, 2)
  currentBalance Decimal       @default(0) @db.Decimal(15, 2)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  transactions   Transaction[]
  transfersFrom  Transfer[]    @relation("SourceAccount")
  transfersTo    Transfer[]    @relation("DestinationAccount")
}

model Transaction {
  id          Int             @id @default(autoincrement())
  amount      Decimal         @db.Decimal(15, 2)
  type        TransactionType
  date        DateTime        @default(now())
  description String?
  approved    Boolean         @default(false)
  approvedAt  DateTime?
  approvedBy  String?
  categoryId  Int
  accountId   Int
  userId      String
  createdAt   DateTime        @default(now())
  received    Boolean         @default(false)
  deleted     Boolean         @default(false)
  deletedAt   DateTime?
  account     Account         @relation(fields: [accountId], references: [id])
  category    Category        @relation(fields: [categoryId], references: [id])
  user        User            @relation(fields: [userId], references: [id])
}

model Transfer {
  id            Int      @id @default(autoincrement())
  amount        Decimal  @db.Decimal(15, 2)
  date          DateTime @default(now())
  description   String?
  fromAccountId Int
  toAccountId   Int
  createdAt     DateTime @default(now())
  fromAccount   Account  @relation("SourceAccount", fields: [fromAccountId], references: [id])
  toAccount     Account  @relation("DestinationAccount", fields: [toAccountId], references: [id])
}

model Customer {
  id                     Int       @id @default(autoincrement())
  name                   String
  phone                  String?
  depositDate            DateTime?
  contractDate           DateTime?
  depositAmount          Decimal?  @db.Decimal(15, 2)
  contractAmount         Decimal?  @db.Decimal(15, 2)
  commission             Int?
  received               Boolean   @default(false)
  performedBy            String?
  createdAt              DateTime  @default(now())
  contractValidityMonths Int?
  deleted                Boolean   @default(false)
  deletedAt              DateTime?
}

enum TransactionType {
  INCOME
  EXPENSE
}
